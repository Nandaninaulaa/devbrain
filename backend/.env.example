# Copy this to .env and fill in as needed. Everything has a sane default —
# the app runs with zero config in retrieval-only, local-embedding mode.

# "local" (sentence-transformers, free) or "openai" (better quality, needs key)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# "openai" to generate real answers/flashcards, or "none" for retrieval-only
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=

TOP_K=5
COLLECTION_NAME=developer_brain

# Knowledge graph (Phase 3) — defaults match the docker-compose Neo4j service
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devbrain123
