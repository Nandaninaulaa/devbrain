# Copy to .env in this same folder (project root, next to docker-compose.yml)
# and docker-compose will pick these up automatically.

# Leave LLM_PROVIDER=none to run with zero API cost (retrieval-only Q&A,
# heuristic flashcards, symbol-name-only graph). Set to "openai" once you
# have a key to get real generated answers, better flashcards, and richer
# concept extraction in the graph.
LLM_PROVIDER=none
OPENAI_API_KEY=

# Absolute path to the folder containing the projects you want to ingest.
# Mounted read-only into the backend container at /host-projects, so when
# using the Ingest tab, point it at e.g. "/host-projects/nutritrack" instead
# of the Windows path you'd use outside Docker.
HOST_PROJECTS_DIR=C:/Users/nanda/Downloads
